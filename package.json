{
  "name": "rtl-skill",
  "version": "0.1.0",
  "description": "Teach coding agents to build correct right-to-left interfaces, then check the result in a real browser.",
  "type": "module",
  "license": "MIT",
  "author": "Mohaned Elhagar",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "skill": "node scripts/build-skill.ts",
    "skill:check": "node scripts/build-skill.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "rtl",
    "right-to-left",
    "arabic",
    "hebrew",
    "persian",
    "urdu",
    "bidi",
    "claude-code",
    "cursor",
    "codex",
    "agent-skills",
    "playwright",
    "i18n",
    "accessibility"
  ]
}
