{
  "name": "rtl-skill",
  "version": "0.1.0",
  "description": "Teach coding agents to build correct right-to-left interfaces, then check the result in a real browser.",
  "type": "module",
  "license": "MIT",
  "author": "Mohaned Elhagar",
  "homepage": "https://github.com/Ifazawezk/rtl-skill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ifazawezk/rtl-skill.git"
  },
  "keywords": [
    "rtl",
    "right-to-left",
    "arabic",
    "hebrew",
    "persian",
    "urdu",
    "bidi",
    "claude-code",
    "cursor",
    "codex",
    "agent-skills",
    "playwright",
    "i18n",
    "accessibility"
  ],
  "bin": {
    "rtl-check": "dist/rtl-check.js",
    "rtl-skill": "dist/rtl-skill.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "cursor",
    "codex",
    "skill-src",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "skill": "node scripts/build-skill.ts",
    "skill:check": "node scripts/build-skill.ts --check",
    "bench": "node scripts/bench.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
